# Bearer token clients must present on POST /extract.
API_BEARER_TOKEN=replace-with-a-long-random-string

# Datalab API key, from https://www.datalab.to (free tier is enough).
# Sent as the X-API-Key header, not as a bearer token.
DATALAB_API_KEY=

# Datalab submit endpoint. The assignment specifies the Marker API; Datalab now
# recommends /api/v1/convert, which has an identical contract for the fields used
# here. Swapping the two is a one-line change.
DATALAB_API_URL=https://www.datalab.to/api/v1/marker

# fast | balanced | accurate. Lab reports are dense tables, so balanced is a
# reasonable default; fast is cheaper on the free tier.
DATALAB_MODE=balanced

DATALAB_POLL_INTERVAL_MS=2000
DATALAB_POLL_TIMEOUT_MS=180000

# datalab | fixture. The fixture provider replays a saved Datalab response so the
# service can be run and tested without an account. See README.
OCR_PROVIDER=datalab
OCR_FIXTURE_PATH=examples/sample-ocr-output.md

PORT=3000
MAX_FILE_SIZE_BYTES=10485760
LOG_LEVEL=info
